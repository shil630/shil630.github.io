#!/usr/bin/env bash
# 发布前唯一检查入口：生产构建 + 关键产物冒烟检查。
set -euo pipefail
cd "$(dirname "$0")"

if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - bash 2>/dev/null || rbenv init - zsh)" || true
fi
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

if ! bundle exec jekyll --version >/dev/null 2>&1; then
  echo "依赖不可用，先运行 ./setup"
  exit 1
fi

DRAFT_FLAG=()
if [[ "${1:-}" == "--draft" ]] || [[ "${1:-}" == "-d" ]]; then
  DRAFT_FLAG=(--drafts)
fi

CHECK_TMP_ROOT="${TMPDIR:-/tmp}"
CHECK_TMP_ROOT="${CHECK_TMP_ROOT%/}"
CHECK_BUILD_DIR="$(mktemp -d "$CHECK_TMP_ROOT/shiliang-check.XXXXXX")"

cleanup() {
  case "$CHECK_BUILD_DIR" in
    "$CHECK_TMP_ROOT"/shiliang-check.*) rm -rf -- "$CHECK_BUILD_DIR" ;;
  esac
}
trap cleanup EXIT

if command -v node >/dev/null 2>&1; then
  echo "→ 前端单元测试"
  node --test tests/*.test.cjs
fi

echo "→ 生产构建"
JEKYLL_ENV=production bundle exec jekyll build \
  --destination "$CHECK_BUILD_DIR" \
  ${DRAFT_FLAG[@]+"${DRAFT_FLAG[@]}"}

echo "→ 关键产物检查"
bundle exec ruby - "$CHECK_BUILD_DIR" <<'RUBY'
require "nokogiri"
require "uri"
require "json"

build_dir = ARGV.fetch(0)

required_pages = {
  "首页" => "index.html",
  "作品页" => "work/index.html",
  "归档页" => "archive/index.html",
  "工具页" => "tools/index.html",
  "关于页" => "about/index.html",
  "404" => "404.html",
  "RSS" => "feed.xml",
  "sitemap" => "sitemap.xml",
  "robots" => "robots.txt",
  "llms" => "llms.txt"
}

missing = required_pages.filter_map do |label, relative_path|
  label unless File.file?(File.join(build_dir, relative_path))
end
abort "缺少构建产物：#{missing.join(' / ')}" unless missing.empty?

def assert!(condition, message)
  abort message unless condition
end

home = File.read(File.join(build_dir, "index.html"), encoding: "UTF-8")
assert!(home.include?('<html lang="zh">'), "首页 html[lang] 不是 zh")
assert!(home.include?('id="lang-toggle"'), "首页缺少语言切换器")
assert!(home.match?(/\sdata-en=/) && home.match?(/\sdata-zh=/), "首页缺少双语界面文案")
assert!(home.include?('rel="canonical"'), "首页缺少 canonical")
assert!(home.include?('property="og:'), "首页缺少 Open Graph 元数据")

markers = ["精选", "最新文章", "UX 作品集", "订阅正EV实验"]
positions = markers.map { |marker| home.index(marker) }
assert!(positions.none?(&:nil?) && positions == positions.sort, "首页内容顺序不符合预期")

article_paths = Dir.glob(File.join(build_dir, "posts", "**", "index.html"))
assert!(!article_paths.empty?, "未生成任何文章页")
article = File.read(article_paths.max, encoding: "UTF-8")
assert!(article.include?('<html lang="zh">'), "文章页 html[lang] 不是 zh")
assert!(article.include?('<article class="post wrap" lang="zh">'), "文章正文 lang 不是 zh")

%w[work archive tools about].each do |slug|
  page = File.read(File.join(build_dir, slug, "index.html"), encoding: "UTF-8")
  assert!(page.include?('<html lang="zh">'), "#{slug} 页 html[lang] 不是 zh")
  assert!(page.match?(/\sdata-en=/) && page.match?(/\sdata-zh=/), "#{slug} 页缺少双语界面文案")
end

featured_count = home.scan('class="featured-card"').length
tool_dirs = Dir.glob(File.join(build_dir, "tools", "*", "index.html")).map do |path|
  File.basename(File.dirname(path))
end
tool_ids = tool_dirs.sort
assert!(tool_ids.size >= 3, "工具目录少于预期：#{tool_ids.inspect}")
tool_titles = []
tool_descriptions = []
sitemap = File.read(File.join(build_dir, "sitemap.xml"))
tool_ids.each do |tool_id|
  relative_path = "tools/#{tool_id}/index.html"
  assert!(File.file?(File.join(build_dir, relative_path)), "工具页缺失：#{tool_id}")
  html = File.read(File.join(build_dir, relative_path))
  doc = Nokogiri::HTML(html)
  canonical = "https://shiliang.me/tools/#{tool_id}/"
  head = doc.at_css("head")
  assert!(head.css("title").size == 1 && !head.at_css("title").text.strip.empty?, "#{tool_id} title 缺失或重复")
  tool_titles << head.at_css("title").text
  {
    'meta[name="description"]' => nil,
    'link[rel="canonical"]' => canonical,
    'meta[property="og:url"]' => canonical,
    'meta[property="og:title"]' => nil,
    'meta[property="og:description"]' => nil,
    'meta[property="og:type"]' => "website",
    'meta[property="og:image"]' => nil,
    'meta[name="twitter:card"]' => "summary_large_image",
    'meta[name="twitter:title"]' => nil,
    'meta[name="twitter:description"]' => nil,
    'meta[name="twitter:image"]' => nil
  }.each do |selector, expected|
    nodes = head.css(selector)
    assert!(nodes.size == 1, "#{tool_id} #{selector} 缺失或重复")
    value = nodes.first[selector.start_with?("link") ? "href" : "content"]
    assert!(value && !value.strip.empty? && (!expected || value == expected), "#{tool_id} #{selector} 值不正确")
  end
  tool_descriptions << head.at_css('meta[name="description"]')["content"]

  # JSON-LD (WebApplication + BreadcrumbList) 结构化数据深度断言
  ld_json_nodes = head.css('script[type="application/ld+json"]')
  assert!(ld_json_nodes.size == 1, "#{tool_id} application/ld+json 脚本必须恰好有 1 个")
  schema = JSON.parse(ld_json_nodes.first.text)
  assert!(schema["@context"] == "https://schema.org", "#{tool_id} JSON-LD @context 必须为 https://schema.org")
  graph = schema["@graph"]
  assert!(graph.is_a?(Array) && graph.size >= 2, "#{tool_id} JSON-LD 必须包含 @graph 数组且至少有 2 个实体")

  webapp = graph.find { |node| node["@type"] == "WebApplication" }
  assert!(webapp, "#{tool_id} 缺少 WebApplication 结构化数据")
  assert!(webapp["@id"] == "#{canonical}#webapp", "#{tool_id} WebApplication @id 必须为 #{canonical}#webapp")
  assert!(webapp["name"] && !webapp["name"].strip.empty?, "#{tool_id} WebApplication 缺少 name")
  assert!(webapp["description"] && !webapp["description"].strip.empty?, "#{tool_id} WebApplication 缺少 description")
  assert!(webapp["url"] == canonical, "#{tool_id} WebApplication url 必须匹配 canonical")
  assert!(webapp["applicationCategory"] && !webapp["applicationCategory"].strip.empty?, "#{tool_id} WebApplication 缺少 applicationCategory")
  assert!(webapp["operatingSystem"] == "All", "#{tool_id} WebApplication operatingSystem 必须为 All")
  assert!(webapp["browserRequirements"] == "Requires JavaScript. Requires HTML5.", "#{tool_id} WebApplication browserRequirements 声明不正确")
  assert!(webapp["isAccessibleForFree"] == true, "#{tool_id} WebApplication isAccessibleForFree 必须为 true")
  assert!(webapp.dig("offers", "@type") == "Offer" && webapp.dig("offers", "price") == "0", "#{tool_id} WebApplication offers 必须为免费 Offer")
  assert!(webapp.dig("author", "@type") == "Person" && webapp.dig("author", "name") == "石亮 / Liang Shi", "#{tool_id} WebApplication author 声明不正确")
  assert!(webapp["permissions"] && webapp["permissions"].include?("浏览器本地运行"), "#{tool_id} WebApplication permissions 必须包含本地运行隐私声明")
  assert!(webapp["featureList"] && !webapp["featureList"].strip.empty?, "#{tool_id} WebApplication featureList 缺少功能特性清单")

  breadcrumbs = graph.find { |node| node["@type"] == "BreadcrumbList" }
  assert!(breadcrumbs, "#{tool_id} 缺少 BreadcrumbList 结构化数据")
  assert!(breadcrumbs["@id"] == "#{canonical}#breadcrumb", "#{tool_id} BreadcrumbList @id 必须为 #{canonical}#breadcrumb")
  crumbs = breadcrumbs["itemListElement"]
  assert!(crumbs.is_a?(Array) && crumbs.size == 3, "#{tool_id} BreadcrumbList 必须恰好有 3 级导航")
  assert!(crumbs[0]["position"] == 1 && crumbs[0]["name"] == "首页" && crumbs[0]["item"] == "https://shiliang.me/", "#{tool_id} 面包屑第 1 级（首页）不正确")
  assert!(crumbs[1]["position"] == 2 && crumbs[1]["name"] == "工具" && crumbs[1]["item"] == "https://shiliang.me/tools/", "#{tool_id} 面包屑第 2 级（工具）不正确")
  assert!(crumbs[2]["position"] == 3 && crumbs[2]["name"] == webapp["name"] && crumbs[2]["item"] == canonical, "#{tool_id} 面包屑第 3 级（具体工具）不正确")

  assert!(html.scan("googletagmanager.com/gtm.js").size == 1, "#{tool_id} GTM 缺失或重复")
  trackers = doc.css('script[src^="/assets/js/tool-analytics.js"]')
  assert!(trackers.size == 1 && trackers.first['data-tool-id'] == tool_id && trackers.first['data-measurement-id'] == 'G-MQH963M94G', "#{tool_id} 工具埋点配置不正确")
  assert!(!html.include?("{%") && !html.include?("{{"), "#{tool_id} 存在未渲染 Liquid")
  assert!(sitemap.include?(canonical), "#{tool_id} 未进入 sitemap")
  resources = doc.css('script[src], link[rel="icon"], link[rel="alternate icon"]').map { |el| el['src'] || el['href'] }
  resources << head.at_css('meta[property="og:image"]')['content']
  resources << head.at_css('meta[name="twitter:image"]')['content']
  resources.each do |url|
    uri = URI.parse(url)
    next if uri.host && uri.host != "shiliang.me"
    assert!(File.file?(File.join(build_dir, uri.path.sub(%r{\A/}, ""))), "#{tool_id} 资源不存在：#{url}")
  end
  assert!(doc.css('form.subscribe-form').size >= 1, "#{tool_id} 缺少订阅表单")
  assert!(doc.css('a[data-cta-type="tool_related_article"]').size >= 1, "#{tool_id} 缺少深度文章推荐")
  if tool_id == "investment-checklist"
    assert!(doc.css('#copyMdBtn').size == 1, "investment-checklist 缺少复制 Markdown 按钮")
    assert!(doc.css('#downloadMdBtn').size == 1, "investment-checklist 缺少下载 Markdown 按钮")
    assert!(doc.css('#loadPaypalSampleBtn').size == 1, "investment-checklist 缺少载入 PayPal 案例按钮")
    assert!(doc.css('#loadLiteSampleBtn').size == 1, "investment-checklist 缺少载入 LITE 案例按钮")
    assert!(doc.css('input[name="size_hard_cap"]').size == 1, "investment-checklist 缺少仓位硬顶上限输入框")
    assert!(doc.css('textarea[name="ev_premortem"]').size == 1, "investment-checklist 缺少 Pre-mortem 事前验尸输入框")
  end
  if tool_id == "wechat-formatter"
    assert!(doc.css('.mobile-header').size == 1, "wechat-formatter 缺少移动端导航条")
    assert!(doc.css('#tabEdit').size == 1 && doc.css('#tabPreview').size == 1, "wechat-formatter 缺少移动端 Tab 控件")
    assert!(doc.css('#tunePanel').size == 1, "wechat-formatter 缺少微调控制面板")
    assert!(!html.include?('letter-spacing:.14em;margin-bottom:10px;">引言</span>'), "wechat-formatter 依然包含引言标签")
  end
end
assert!(tool_titles.uniq.size == tool_ids.size && tool_descriptions.uniq.size == tool_ids.size, "工具 title/description 必须各自独立")
puts "✓ 工具的唯一元数据、JSON-LD (WebApplication + BreadcrumbList)、GTM、事件脚本、分享图、文章推荐、订阅与 sitemap 正常"


preflop_article_path = Dir.glob(File.join(build_dir, "posts", "**", "preflop-range-ev", "index.html")).first
assert!(preflop_article_path && File.file?(preflop_article_path), "德州文章缺失")
preflop_article = File.read(preflop_article_path, encoding: "UTF-8")
assert!(preflop_article.include?('class="post-related-tool"'), "德州文章缺少工具 Callout")
assert!(preflop_article.include?('/tools/preflop-range/'), "德州文章工具 Callout 目标不正确")

checklist_article_path = Dir.glob(File.join(build_dir, "posts", "**", "paypal-value-trap-checklist", "index.html")).first
assert!(checklist_article_path && File.file?(checklist_article_path), "PayPal 清单文章缺失")
checklist_article = File.read(checklist_article_path, encoding: "UTF-8")
assert!(checklist_article.include?('class="post-related-tool"'), "PayPal 清单文章缺少工具 Callout")
assert!(checklist_article.include?('/tools/investment-checklist/'), "PayPal 清单文章工具 Callout 目标不正确")
puts "✓ 文章 ⇄ 工具双向 Callout 关联验证正常"

llms = File.read(File.join(build_dir, "llms.txt"), encoding: "UTF-8")
assert!(llms.include?("# 石亮正EV"), "llms.txt 缺少主标题")
assert!(llms.include?("https://shiliang.me/tools/investment-checklist/"), "llms.txt 缺少工具链接")
assert!(llms.scan(%r{https://shiliang\.me/posts/\d{4}/\d{2}/\d{2}/}).size >= 5, "llms.txt 文章链接少于预期")
assert!(!llms.include?("{%") && !llms.include?("{{"), "llms.txt 存在未渲染 Liquid")
puts "✓ llms.txt 生成正常且包含站点定位、工具与深度文章索引"
latest_count = home.scan('class="post-item"').length
puts "✓ 首页内容顺序：精选 → 最新文章 → UX 作品集 → 订阅"
puts "✓ 首页内容基线：#{featured_count} 篇精选，#{latest_count} 篇最新文章"
puts "✓ 双语界面、中文内容语义、canonical、Open Graph 与关键页面产物正常"
RUBY

echo "✓ 发布前检查通过"
