#!/usr/bin/env bash
# 发布前唯一检查入口：生产构建 + 关键产物冒烟检查。
set -euo pipefail
cd "$(dirname "$0")"

if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - bash 2>/dev/null || rbenv init - zsh)" || true
fi
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

if ! bundle exec jekyll --version >/dev/null 2>&1; then
  echo "依赖不可用，先运行 ./setup"
  exit 1
fi

DRAFT_FLAG=()
if [[ "${1:-}" == "--draft" ]] || [[ "${1:-}" == "-d" ]]; then
  DRAFT_FLAG=(--drafts)
fi

CHECK_TMP_ROOT="${TMPDIR:-/tmp}"
CHECK_TMP_ROOT="${CHECK_TMP_ROOT%/}"
CHECK_BUILD_DIR="$(mktemp -d "$CHECK_TMP_ROOT/shiliang-check.XXXXXX")"

cleanup() {
  case "$CHECK_BUILD_DIR" in
    "$CHECK_TMP_ROOT"/shiliang-check.*) rm -rf -- "$CHECK_BUILD_DIR" ;;
  esac
}
trap cleanup EXIT

echo "→ 生产构建"
JEKYLL_ENV=production bundle exec jekyll build \
  --destination "$CHECK_BUILD_DIR" \
  ${DRAFT_FLAG[@]+"${DRAFT_FLAG[@]}"}

echo "→ 关键产物检查"
bundle exec ruby - "$CHECK_BUILD_DIR" <<'RUBY'
require "nokogiri"
require "uri"
build_dir = ARGV.fetch(0)

required_pages = {
  "首页" => "index.html",
  "作品页" => "work/index.html",
  "归档页" => "archive/index.html",
  "工具页" => "tools/index.html",
  "关于页" => "about/index.html",
  "404" => "404.html",
  "RSS" => "feed.xml",
  "sitemap" => "sitemap.xml",
  "robots" => "robots.txt",
  "llms" => "llms.txt"
}

missing = required_pages.filter_map do |label, relative_path|
  label unless File.file?(File.join(build_dir, relative_path))
end
abort "缺少构建产物：#{missing.join(' / ')}" unless missing.empty?

def assert!(condition, message)
  abort message unless condition
end

home = File.read(File.join(build_dir, "index.html"), encoding: "UTF-8")
assert!(home.include?('<html lang="zh">'), "首页 html[lang] 不是 zh")
assert!(home.include?('id="lang-toggle"'), "首页缺少语言切换器")
assert!(home.match?(/\sdata-en=/) && home.match?(/\sdata-zh=/), "首页缺少双语界面文案")
assert!(home.include?('rel="canonical"'), "首页缺少 canonical")
assert!(home.include?('property="og:'), "首页缺少 Open Graph 元数据")

markers = ["精选", "最新文章", "UX 作品集", "订阅正EV实验"]
positions = markers.map { |marker| home.index(marker) }
assert!(positions.none?(&:nil?) && positions == positions.sort, "首页内容顺序不符合预期")

article_paths = Dir.glob(File.join(build_dir, "posts", "**", "index.html"))
assert!(!article_paths.empty?, "未生成任何文章页")
article = File.read(article_paths.max, encoding: "UTF-8")
assert!(article.include?('<html lang="zh">'), "文章页 html[lang] 不是 zh")
assert!(article.include?('<article class="post wrap" lang="zh">'), "文章正文 lang 不是 zh")

%w[work archive tools about].each do |slug|
  page = File.read(File.join(build_dir, slug, "index.html"), encoding: "UTF-8")
  assert!(page.include?('<html lang="zh">'), "#{slug} 页 html[lang] 不是 zh")
  assert!(page.match?(/\sdata-en=/) && page.match?(/\sdata-zh=/), "#{slug} 页缺少双语界面文案")
end

featured_count = home.scan('class="featured-card"').length
tool_ids = %w[investment-checklist wechat-formatter preflop-range]
tool_titles = []
tool_descriptions = []
sitemap = File.read(File.join(build_dir, "sitemap.xml"))
tool_ids.each do |tool_id|
  relative_path = "tools/#{tool_id}/index.html"
  assert!(File.file?(File.join(build_dir, relative_path)), "工具页缺失：#{tool_id}")
  html = File.read(File.join(build_dir, relative_path))
  doc = Nokogiri::HTML(html)
  canonical = "https://shiliang.me/tools/#{tool_id}/"
  head = doc.at_css("head")
  assert!(head.css("title").size == 1 && !head.at_css("title").text.strip.empty?, "#{tool_id} title 缺失或重复")
  tool_titles << head.at_css("title").text
  {
    'meta[name="description"]' => nil,
    'link[rel="canonical"]' => canonical,
    'meta[property="og:url"]' => canonical,
    'meta[property="og:title"]' => nil,
    'meta[property="og:description"]' => nil,
    'meta[property="og:type"]' => "website",
    'meta[property="og:image"]' => nil,
    'meta[name="twitter:card"]' => "summary_large_image",
    'meta[name="twitter:title"]' => nil,
    'meta[name="twitter:description"]' => nil,
    'meta[name="twitter:image"]' => nil
  }.each do |selector, expected|
    nodes = head.css(selector)
    assert!(nodes.size == 1, "#{tool_id} #{selector} 缺失或重复")
    value = nodes.first[selector.start_with?("link") ? "href" : "content"]
    assert!(value && !value.strip.empty? && (!expected || value == expected), "#{tool_id} #{selector} 值不正确")
  end
  tool_descriptions << head.at_css('meta[name="description"]')["content"]
  assert!(html.scan("googletagmanager.com/gtm.js").size == 1, "#{tool_id} GTM 缺失或重复")
  trackers = doc.css('script[src^="/assets/js/tool-analytics.js"]')
  assert!(trackers.size == 1 && trackers.first['data-tool-id'] == tool_id && trackers.first['data-measurement-id'] == 'G-MQH963M94G', "#{tool_id} 工具埋点配置不正确")
  assert!(!html.include?("{%") && !html.include?("{{"), "#{tool_id} 存在未渲染 Liquid")
  assert!(sitemap.include?(canonical), "#{tool_id} 未进入 sitemap")
  resources = doc.css('script[src], link[rel="icon"], link[rel="alternate icon"]').map { |el| el['src'] || el['href'] }
  resources << head.at_css('meta[property="og:image"]')['content']
  resources << head.at_css('meta[name="twitter:image"]')['content']
  resources.each do |url|
    uri = URI.parse(url)
    next if uri.host && uri.host != "shiliang.me"
    assert!(File.file?(File.join(build_dir, uri.path.sub(%r{\A/}, ""))), "#{tool_id} 资源不存在：#{url}")
  end
end
assert!(tool_titles.uniq.size == tool_ids.size && tool_descriptions.uniq.size == tool_ids.size, "工具 title/description 必须各自独立")
puts "✓ 三个工具的唯一元数据、GTM、事件脚本、分享图与 sitemap 正常"

llms = File.read(File.join(build_dir, "llms.txt"), encoding: "UTF-8")
assert!(llms.include?("# 石亮正EV"), "llms.txt 缺少主标题")
assert!(llms.include?("https://shiliang.me/tools/investment-checklist/"), "llms.txt 缺少工具链接")
assert!(llms.scan(%r{https://shiliang\.me/posts/\d{4}/\d{2}/\d{2}/}).size >= 5, "llms.txt 文章链接少于预期")
assert!(!llms.include?("{%") && !llms.include?("{{"), "llms.txt 存在未渲染 Liquid")
puts "✓ llms.txt 生成正常且包含站点定位、工具与深度文章索引"
latest_count = home.scan('class="post-item"').length
puts "✓ 首页内容顺序：精选 → 最新文章 → UX 作品集 → 订阅"
puts "✓ 首页内容基线：#{featured_count} 篇精选，#{latest_count} 篇最新文章"
puts "✓ 双语界面、中文内容语义、canonical、Open Graph 与关键页面产物正常"
RUBY

echo "✓ 发布前检查通过"
